$bin?=@https://github.com/SleemEMG/SleemOS/releases/latest/download/SleemOS.bin
mach create "SleemOS"
machine LoadPlatformDescription @https://raw.githubusercontent.com/SleemEMG/SleemOS/main/sleemos.repl

macro reset
"""
    sysbus LoadBinary $bin 0x08000000
    sysbus.cpu VectorTableOffset 0x08000000
"""
runMacro $reset

emulation CreateServerSocketTerminal 12345 "sleemos-uart" false
connector Connect sysbus.usart2 sleemos-uart
showAnalyzer sysbus.usart2
start